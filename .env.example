# Nunca compartilhe este arquivo preenchido com seu token.
# Renomeie para .env e preencha os valores.

# Discord Bot
DISCORD_TOKEN=
CLIENT_ID=
# Deixe em branco para registrar comandos globalmente ou preencha para servidor específico
GUILD_ID=

# Painel Administrativo
PANEL_PORT=3000

# Banco de Dados
DATABASE_PATH=./data/crowbot.db

# Jobs/Queue (Redis opcional - usa Bull padrão em memória se não configurado)
REDIS_URL=

# Licença
LICENSE_PUBLIC_KEY=COLE_AQUI_A_CHAVE_PUBLICA_ED25519
# Opcionais para alertas externos
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
