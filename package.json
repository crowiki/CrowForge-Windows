{
  "name": "crowbot-ultimate",
  "version": "1.1.0",
  "description": "CrowForge para Discord — aplicativo Windows e painel local",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bot": "node apps/bot/index.js",
    "api": "node apps/local-api/index.js",
    "dashboard": "cd apps/dashboard && npm run dev",
    "deploy": "node apps/bot/deploy-commands.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "migrate:json": "node packages/db/migrate-from-json.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.12",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.2.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0"
  }
}
